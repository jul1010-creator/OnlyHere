#!/bin/sh
# ── REFUSE A PUSH THAT WOULD GO RED ─────────────────────────────────
#
# 22 August 2026. Seven source files went up in one commit and their
# assertions in the next, so CI ran new code against old expectations and
# mailed a failure for a tree that was already correct on disk.
#
# That is not a slip, it is the shape of this suite. A lot of it pins exact
# source strings: AuthSheet.jsx is asserted to contain a particular call,
# terms.html is asserted to carry a particular date. The trade is deliberate
# and it catches real regressions, but it means a change and its assertions
# have to travel together or the build goes red every time.
#
# So the check moves to before the push, where it costs twenty seconds and
# nobody gets an email about it.
#
# Runs exactly what .github/workflows/build-check.yml runs, in the same
# order, so green here means green there. Drop the build line if twenty
# seconds is too slow and you would rather only guard the suite.
#
# git runs hooks from the top of the working tree, so this cd is from the
# repo root rather than from .githooks.
#
# To bypass once, deliberately: git push --no-verify

set -e
cd onlyhere-project

printf "pre-push: running the suite\\n"
node tests/run.mjs

printf "pre-push: building\\n"
npm run build --silent

printf "pre-push: green, pushing\\n"
