# The repository root. The app has its own list in onlyhere-project/.gitignore.
# Local env files hold real keys and must never be committed (security review,
# 3 Oct 2026, finding 10).
.env
.env.*
!.env.example
.vercel
node_modules
.DS_Store

# Git bundles and the dated Claude output folders hold unreleased work and
# private hand-off notes (security review, 17 Oct 2026). Files already
# committed there stay tracked; nothing new goes in.
*.bundle
Claude outputs/
